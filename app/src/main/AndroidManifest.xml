<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Quest: declare headtracking; required=false lets it also run as a 2D panel app -->
    <uses-feature android:name="android.hardware.vr.headtracking" android:required="false" android:version="1" />
    <uses-feature android:name="oculus.software.handtracking" android:required="false" />

    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:label="Quest Standalone Steam"
        android:theme="@style/Theme.AppCompat.NoActionBar">

        <meta-data android:name="com.oculus.supportedDevices" android:value="quest3|quest3s|quest2|questpro" />

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".LoginActivity" android:exported="false" />
        <activity android:name=".RuntimeActivity" android:exported="false" android:configChanges="orientation|screenSize|keyboardHidden" />
    </application>
</manifest>
